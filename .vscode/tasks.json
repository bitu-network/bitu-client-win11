{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Header Injector Daemon",
      "type": "shell",
      "command": "python -m cli.dev.watch",
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "isBackground": true
    }
  ]
}